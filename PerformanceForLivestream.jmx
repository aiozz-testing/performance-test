        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// Get the last match number as a string
def lastIndex = vars.get(&quot;audio_last_uri_matchNr&quot;)
log.info(&quot;The number of audio last url that match: &quot; + lastIndex)

// Ensure lastIndex is not null or empty
if (lastIndex &amp;&amp; !lastIndex.isEmpty()) {
    // Construct the variable name dynamically
    def lastUriVar = &quot;audio_last_uri_&quot; + lastIndex + &quot;_g1&quot;
    
    // Retrieve its value from JMeter variables
    def lastUri = vars.get(lastUriVar)
    
    log.info(&quot;Dynamically extracted last URI: &quot; + lastUri)

    // Store it in a new variable for use in HTTP requests
    vars.put(&quot;audio_final_last_uri&quot;, lastUri)
} else {
    log.warn(&quot;No audio valid last URI found!&quot;)
}
</stringProp>
          </JSR223PreProcessor>
