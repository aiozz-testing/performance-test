        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.UUID;

// Generate a random UUID
def sessionId = UUID.randomUUID().toString();

// Save the UUID to a JMeter variable
vars.put(&quot;session_id&quot;, sessionId);

// Log the generated session_id (optional)
log.info(&quot;Generated session_id: &quot; + sessionId);</stringProp>
          </JSR223PreProcessor>
